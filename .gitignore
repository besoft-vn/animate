# renders and intermediates are rebuilt by the tools
**/frames/
**/renders/
**/review/*-vs-ref.*
node_modules/
__pycache__/
# built files (tools/build.mjs makes them from src/ + kit/ + the style)
plugins/**/index.html
plugins/**/review/
# pieces: built page, scratch voices and voice samples are regenerated
pieces/**/index.html
pieces/**/review/
pieces/**/voice/*.scratch.wav
pieces/**/voice/samples/
pieces/**/deliver/
